<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:layout_marginBottom="16dp"
    android:padding="12dp">

    <!-- Username + Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="sneakerslt"
            android:textStyle="bold"
            android:textSize="14sp"
            android:fontFamily="@font/instagram_sans"/>

        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • 3 weeks ago"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- Caption -->
    <TextView
        android:id="@+id/tvCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fresh kicks for sale! Size 42 • Never worn • DM for more pics and details. #sneakers #forsale"
        android:textSize="13sp"
        android:textColor="#444444"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/instagram_sans"/>

    <!-- Open in Instagram -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnOpenInstagram"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Open in Instagram"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:background="@drawable/gradient_button"
        android:drawableEnd="@drawable/ic_link"
        android:paddingHorizontal="100dp"
        android:textAllCaps="false"
        android:drawablePadding="8dp"/>
</LinearLayout>